@model Foodezon.Core.Models.Discount

@{
    var dishes = ViewBag.Dishes as List<Foodezon.Core.Models.Dish>;
}

<h2>Create Discount</h2>

@using (Html.BeginForm())
{
    <div class="form-group">
        @Html.LabelFor(m => m.DiscountCode)
        @Html.TextBoxFor(m => m.DiscountCode, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.DiscountCode)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Percentage)
        @Html.TextBoxFor(m => m.Percentage, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Percentage)
    </div>

    <div class="form-group">
        @Html.Label("Dish")
        <select class="form-control" name="DishId">
            <option value="">-- Select Dish --</option>
            @foreach (var d in dishes)
            {
                <option value="@d.DishId">@d.Name</option>
            }
        </select>
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.StartDate)
        @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.EndDate)
        @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
    </div>

    <button type="submit" class="btn btn-success">Create</button>
}
