@model IEnumerable<Foodezon.Core.Models.Dish>

@{
    ViewBag.Title = "Dishes";
}

<h2>Dishes</h2>

<p>
    <a class="btn btn-primary" href="@Url.Action("Create")">Create New Dish</a>
</p>

<table class="table table-bordered">
<tr>
<th>Name</th>
<th>Category</th>
<th>Price</th>
<th></th>
</tr>

@foreach (var d in Model)
{
    <tr>
        <td>@d.Name</td>
        <td>@d.Category?.Name</td>
        <td>@d.Price</td>
        <td>
            <a href="@Url.Action("Edit", new { id = d.DishId })" class="btn btn-warning btn-sm">Edit</a>
            <a href="@Url.Action("Delete", new { id = d.DishId })" class="btn btn-danger btn-sm">Delete</a>
        </td>
    </tr>
}
</table>