@model Foodezon.Api.Models.DishFormViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Dish";
}

<div class="container mt-4" style="max-width:800px;">
    <h3>Edit Dish</h3>

    <form method="post">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label">Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>

        <div class="mb-3 row">
            <div class="col">
                <label class="form-label">Price</label>
                <input asp-for="Price" class="form-control" />
            </div>
            <div class="col">
                <label class="form-label">Category</label>
                <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select"></select>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Image URL</label>
            <input asp-for="ImageUrl" class="form-control" />
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsAvailable" class="form-check-input" />
            <label class="form-check-label">Is Available</label>
        </div>

        <button class="btn btn-primary">Update</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
