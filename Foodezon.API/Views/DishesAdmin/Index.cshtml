@model IEnumerable<Foodezon.Core.Models.Dish>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Manage Dishes";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Manage Dishes</h2>
        <a class="btn btn-success" href="/Admin/DishesAdmin/Create">Create Dish</a>
    </div>
    <table class="table table-striped">
        <thead>
            <tr><th>Name</th><th>Category</th><th>Price</th><th>Available</th><th></th></tr>
        </thead>
        <tbody>
        @foreach(var d in Model)
        {
            <tr>
                <td>@d.Name</td>
                <td>@d.Category?</td>
                <td>@d.Price.ToString("0.00")</td>
                <td>@(d.IsAvailable ? "Yes" : "No")</td>
                <td>
                    <a class="btn btn-sm btn-primary" href="/Admin/DishesAdmin/Edit/@d.Id">Edit</a>
                    <a class="btn btn-sm btn-primary" href="/Admin/DishesAdmin/Delete/@d.Id">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>