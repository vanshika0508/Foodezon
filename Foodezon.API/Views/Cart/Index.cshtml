@model Foodezon.Core.DTOs.Cart.CartDto

@{
    ViewData["Title"] = "Your Cart";
}

<div class="container mt-5">

    <h1 class="mb-4" style="color:#ff7a00;">Your Cart</h1>

    @if (!Model.Items.Any())
    {
        <div class="alert alert-warning">
            Your cart is empty. <a href="/Menu">Browse Menu</a>
        </div>
        return;
    }

    <div class="row">

        <!-- CART ITEMS -->
        <div class="col-md-8">

            @foreach (var item in Model.Items)
            {
                <div class="card shadow-sm mb-3 border-0">

                    <div class="card-body d-flex align-items-center">

                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="me-3" 
                                 style="width:80px; height:80px; border-radius:10px;" />
                        }

                        <div class="flex-grow-1">
                            <h5 style="color:#cc6200;">@item.DishName</h5>
                            <p class="text-muted mb-1">Price: $@item.UnitPrice</p>

                            <!-- QUANTITY UPDATE FORM -->
                            <form asp-controller="CartPage" asp-action="UpdateQuantity" 
                                  method="post" class="d-flex align-items-center">
                                <input type="hidden" name="dishId" value="@item.DishId" />

                                <button type="submit" 
                                        class="btn btn-outline-secondary btn-sm"
                                        name="quantity" value="@(item.Quantity - 1)">
                                    –
                                </button>

                                <span class="mx-2">@item.Quantity</span>

                                <button type="submit"
                                        class="btn btn-outline-secondary btn-sm"
                                        name="quantity" value="@(item.Quantity + 1)">
                                    +
                                </button>
                            </form>
                        </div>

                        <!-- REMOVE ITEM FORM -->
                        <form asp-controller="CartPage" asp-action="RemoveItem" method="post">
                            <input type="hidden" name="dishId" value="@item.DishId" />
                            <button type="submit" class="btn btn-danger btn-sm ms-3">
                                Remove
                            </button>
                        </form>

                    </div>

                </div>
            }

        </div>

        <!-- SUMMARY SECTION -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 p-3">

                <h4 style="color:#ff7a00;">Order Summary</h4>

                <p>Subtotal: <strong>$@Model.TotalPrice</strong></p>

                @{
                    decimal delivery = 5.0m;
                    decimal tax = Model.TotalPrice * 0.13m;
                    decimal finalTotal = Model.TotalPrice + delivery + tax;
                }

                <p>Delivery Fee: <strong>$@delivery</strong></p>
                <p>Tax (13%): <strong>$@tax.ToString("0.00")</strong></p>

                <hr />

                <h4>Total: 
                    <strong style="color:#cc6200;">
                        $@finalTotal.ToString("0.00")
                    </strong>
                </h4>

                <!-- CHECKOUT BUTTON -->
                <a href="/Checkout" class="btn btn-danger w-100 mt-3">
                    Proceed to Checkout
                </a>

                <!-- CLEAR CART BUTTON -->
                <form asp-controller="CartPage" asp-action="ClearCart" 
                      method="post" class="mt-2">
                    <button type="submit" class="btn btn-outline-danger w-100">
                        Clear Cart
                    </button>
                </form>

            </div>
        </div>

    </div>

</div>
