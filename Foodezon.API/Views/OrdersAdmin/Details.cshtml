@model Foodezon.Core.Models.Order
@{
    Layout = "_Layout";
    ViewData["Title"] = "Order Details";
}
<div class="container mt-4" style="max-width:900px;">
    <h3>Order @Model.OrderNumber</h3>
    <p><strong style="color:#333;">User:</strong><span style="color:#555;"> @Model.User?.FirstName @Model.User?.LastName (@Model.User?.Email)</span></p>
    <p><strong style="color:#333;">Address:</strong><span style="color:#555;"> @Model.DeliveryAddress</span></p>
    <p><strong style="color:#333;">Phone:</strong><span style="color:#555;"> @Model.PhoneNumber</span></p>
    <p><strong style="color:#333;">Status:</strong><span style="color:#555;"> @Model.Status</span></p>
    <p><strong style="color:#333;">Subtotal:</strong><span style="color:#555;"> $@Model.Subtotal</span></p>
    <p><strong style="color:#333;">Discount:</strong><span style="color:#555;"> $@Model.Discountamount (@Model.Discount?.code)</span></p>
    <p><strong style="color:#333;">Total:</strong><span style="color:#555;"> $@Model.TotalAmount</span></p>
    <table class="table">
        <thead><tr><th>Dish</th><th>Quantity</th><th>Unit</th><th>Line</th><th></th></tr></thead>
        <tbody>
        @foreach(var i in Model.OrderItems)
        {
            <tr>
                <td>@i.Dish?.Name</td>
                <td>@i.Quantity</td>
                <td>@i.UnitPrice.ToString("0.00")/td>
                <td>@i.Quantity*i.UnitPrice.ToString("0.00")</td>
            </tr>
        }
        </tbody>
    </table>
    <a class="btn btn-sm btn-primary" href="/Admin/OrdersAdmin/Index">Back to Index</a>
</div>