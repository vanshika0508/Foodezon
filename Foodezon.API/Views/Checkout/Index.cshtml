@model Foodezon.Api.Models.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<div class="page-overlay">
<div class="container py-5">

    @if (Model.OrderPlaced == true)
    {
        <h1 class="fw-bold text-center mb-5" style="color:#ff7a00; font-size:2.8rem;">
    Order Confirmed 🎉
</h1>

<div class="card p-4 mb-4 shadow-lg confirm-box">

    <h3 class="fw-bold mb-3" style="color:#ff7a00;">Order Details</h3>
    <hr />

    <p class="text-light fs-5">
        <strong>Order Number:</strong> @Model.OrderNumber
    </p>

    <p class="text-light fs-5">
        <strong>Total Paid:</strong> $@Model.FinalTotal
    </p>

    <p class="text-light fs-5">
        Your food is being prepared 🍽️
    </p>
</div>

<div class="text-center">
    <a href="/Menu" class="btn btn-warning fw-bold px-4 py-2">Back to Menu</a>
</div>

<style>
    .confirm-box {
        background: rgba(0, 0, 0, 0.55) !important;               /* DARK like menu */
        border: 1px solid rgba(255,122,0,0.45) !important;        /* ORANGE border */
        border-radius: 12px;
        box-shadow: 0px 0px 15px rgba(0,0,0,0.5);
    }
</style>


       
        return;
    }


    <!-- CART SUMMARY-->
    


    <!-- CHECKOUT -->
    <div class="card p-4 shadow-lg" 
         style="background:rgba(0,0,0,0.15); border:1px solid rgba(0,0,0,0.40);">

        <h3 class="fw-bold mb-3 text-light">Delivery Information</h3>
        <form method="post">
<div class="card p-4 mb-4 order-summary-box">

    <h3 class="fw-bold mb-3" style="color:#ff7a00;">Order Summary</h3>
    <hr />

    @foreach (var item in Model.Cart.Items)
    {
        <p class="fs-5 text-light">
            🥘 <strong>@item.DishName</strong> — Qty: @item.Quantity  
            <span style="color:#ffb36b;"> $@item.UnitPrice x @item.Quantity </span>
        </p>
    }

    <hr />

    <h4 class="fw-bold mb-3 text-light">
        Total:
        <span style="color:#ff7a00;">
            $@Model.Cart.Items.Sum(i => i.UnitPrice * i.Quantity).ToString("0.00")
        </span>
    </h4>
</div>

<style>
    .order-summary-box {
        background: rgba(0, 0, 0, 0.55) !important;      /* DARKER BOX */
        border: 1px solid rgba(255,122,0,0.45) !important; /* ORANGE BORDER */
        border-radius: 12px;
        box-shadow: 0px 0px 12px rgba(0,0,0,0.5);
    }
</style>

            <div class="mb-3">
                <label class="form-label text-light">Full Name</label>
                <input type="text" name="FullName" class="form-control" value="@Model.FullName" required />
            </div>

            <div class="mb-3">
                <label class="form-label text-light">Email</label>
                <input type="email" name="Email" class="form-control" value="@Model.Email" required />
            </div>

            <div class="mb-3">
                <label class="form-label text-light">Phone Number</label>
                <input type="text" name="PhoneNumber" class="form-control" value="@Model.PhoneNumber" required />
            </div>

            <div class="mb-3">
                <label class="form-label text-light">Delivery Address</label>
                <textarea name="Address" class="form-control" required>@Model.Address</textarea>
            </div>

            <div class="mb-4">
                <label class="form-label text-light">Discount Code (optional)</label>
                <input type="text" name="DiscountCode" class="form-control" placeholder="e.g. DIWALI10" />
            </div>

            <button type="submit" class="btn w-100 fw-bold"
                    style="background:#ff7a00; color:black; font-size:1.3rem; padding:12px;">
                Confirm Order & Place Delivery
            </button>
        </form>

       
        }
    </div>

</div>
</div>
