@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-5" style="max-width: 900px;">
    <h2 class="mb-4">Admin Dashboard</h2>

    <div class="row g-4">

        <!-- DISHES -->
        <div class="card shadow-sm p-4 text-center border-0 admin-tile clickable-card"
            onclick="location.href='@Url.Action("Index","DishesAdmin")'" 
            style="cursor:pointer;">
            <h4>Dishes</h4>
            <p class="text-muted">Manage menu items</p>
        </div>

        <!-- CATEGORIES -->
        <div class="col-md-6">
            <div class="card shadow-sm p-4 text-center border-0 admin-tile clickable-card"
                 onclick="location.href='@Url.Action("Index", "CategoriesAdmin")'" style="cursor:pointer;">
                <h4>Categories</h4>
                <p class="text-muted">Edit menu categories</p>
            </div>
        </div>

        <!-- DISCOUNTS -->
        <div class="col-md-6">
            <div class="card shadow-sm p-4 text-center border-0 admin-tile clickable-card"
                 onclick="location.href='@Url.Action("Index", "DiscountsAdmin")'" style="cursor:pointer;">
                <h4>Discounts</h4>
                <p class="text-muted">Manage active discounts</p>
            </div>
        </div>

        <!-- ORDERS -->
        <div class="col-md-6">
            <div class="card shadow-sm p-4 text-center border-0 admin-tile clickable-card"
                 onclick="location.href='@Url.Action("Index", "OrdersAdmin")'" style="cursor:pointer;">
                <h4>Orders</h4>
                <p class="text-muted">View customer orders</p>
            </div>
        </div>

        <!-- LOGOUT -->
        <div class="col-12">
            <form method="post" asp-action="Logout">
                <button class="btn btn-danger w-100 py-2">Logout</button>
            </form>
        </div>

    </div>
</div>

<style>
    /* Optional hover effect for the cards */
    .clickable-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        transition: all 0.2s ease-in-out;
    }
</style>
