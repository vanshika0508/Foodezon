<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Foodezon - Indian Food Delivery</title>

    
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
       

        body {
            background-color: #fff3e6 !important; /* light orange */
        }

        .navbar {
            background-color: #ff7a00 !important; /* orange navbar */
        }

        .navbar .nav-link,
        .navbar .navbar-brand {
            color: white !important;
            font-weight: 600;
        }

        .navbar .nav-link:hover {
            color: #ffe0cc !important;
        }

        .btn-danger {
            background-color: #ff7a00 !important;
            border-color: #ff7a00 !important;
        }

        .btn-danger:hover {
            background-color: #cc6200 !important;
            border-color: #cc6200 !important;
        }

        .card {
            border: 1px solid #ffd1a3 !important;
        }

        .card-title {
            color: #cc6200;
            font-weight: 600;
        }

        .btn-outline-danger {
            color: #ff7a00 !important;
            border-color: #ff7a00 !important;
        }

        .btn-outline-danger:hover {
            background-color: #ff7a00 !important;
            color: white !important;
        }

        h1, h2, h3, h4 {
            color: #cc6200;
            font-weight: 700;
        }

        .form-control:focus {
            border-color: #ff7a00 !important;
            box-shadow: 0 0 0 0.2rem rgba(255, 122, 0, 0.25) !important;
        }

    </style>
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Foodezon</a>

            <div class="navbar-nav">
                <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                <a class="nav-link" asp-controller="Menu" asp-action="Index">Menu</a>
                <a class="nav-link" asp-controller="CartPage" asp-action="Index">Cart</a>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

</body>
</html>
