<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Foodezon</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <style>

       
        body {
            margin: 0;
            padding: 0;
            min-height: 100vh;

            background: url('/images/home-bg.png') no-repeat center center fixed !important;
            background-size: cover !important;
            background-attachment: fixed;
        }

       
        .page-overlay {
            background: rgba(0, 0, 0, 0.55);
            min-height: 100vh;
            padding-bottom: 50px;
        }


        
        .home-overlay {
            background: rgba(255, 255, 255, 0.6);
            padding: 30px;
            border-radius: 15px;
            margin-top: 40px;
            margin-bottom: 40px;
            backdrop-filter: blur(6px);
        }


        .navbar-custom {
            background-color: #ff7a00;
        }

        .navbar-custom .nav-link,
        .navbar-custom .navbar-brand {
            color: white !important;
            font-weight: bold;
        }

        .navbar-custom .nav-link:hover {
            color: #ffe8d1 !important;
        }


       
        .menu-bg {
            background: url('/images/home-bg.png') center/cover no-repeat fixed;
            min-height: 100vh;
            width: 100%;
            position: relative;
        }

        .menu-bg::before {
            content: "";
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(3px);
            z-index: 0;
        }

        .menu-bg > * {
            position: relative;
            z-index: 5;
        }


       
        /* LIGHTER BORDER (updated as you requested) */
        .dish-card {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 16px;
            overflow: hidden;
            transition: 0.3s ease;
            border: 1px solid rgba(255, 122, 0, 0.20); /* lighter border */
            backdrop-filter: blur(3px);
        }

        .dish-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0 25px rgba(255, 122, 0, 0.5);
        }

        .dish-img {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }

        .dish-name {
            color: #ff7a00;
            font-weight: bold;
            font-size: 1.3rem;
        }

        .dish-desc {
            color: #ddd;
        }

        .dish-price {
            color: #ffb36b;
            font-size: 1.2rem;
            font-weight: bold;
        }


        .qty-btn {
            background: transparent;
            color: #ff7a00;
            border: 2px solid #ff7a00;
            padding: 5px 10px;
            border-radius: 50%;
            font-size: 1.2rem;
            font-weight: bold;
            width: 36px;
            height: 36px;
        }

        .qty-number {
            color: white;
            font-size: 1.3rem;
            font-weight: bold;
        }


        .add-btn {
            background: #ff7a00;
            color: white;
            border: none;
            padding: 10px;
            border-radius: 12px;
            font-weight: bold;
            transition: 0.3s;
        }

        .add-btn:hover {
            background: #e36d00;
        }


      
        .cart-button {
            background: transparent;
            border: 2px solid #ff7a00;
            color: #ff7a00;
            padding: 10px 30px;
            font-size: 1.2rem;
            border-radius: 12px;
            font-weight: bold;
            transition: 0.3s;
        }

        .cart-button:hover {
            background: #ff7a00;
            color: white;
        }

    </style>

</head>

<body class="@ViewData["BodyClass"] ?? "default-page"">

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container-fluid px-3">

            <a class="navbar-brand" href="/">Foodezon</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
            </button>

            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="/Menu">Menu</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Cart">Cart</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Checkout">Checkout</a>
                    </li>

                </ul>
            </div>

        </div>
    </nav>

    
    <main class="page-overlay">
        @RenderBody()
    </main>

   
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
