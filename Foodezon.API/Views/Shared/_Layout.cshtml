<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Foodezon</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <style>
        /* BODY BACKGROUND HANDLED BY PAGE */
        body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }

        /* DEFAULT PAGE BACKGROUND (when no custom class is set) */
        body.default-page {
            background: #fff7e6;
        }

        /* HOME PAGE BACKGROUND */
        body.home-page {
            background-image: url('/images/home-bg.png');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            background-repeat: no-repeat;
        }

        /* OVERLAY BOX */
        .home-overlay {
            background: rgba(255, 255, 255, 0.6);
            padding: 30px;
            border-radius: 15px;
            margin-top: 40px;
            margin-bottom: 40px;
            backdrop-filter: blur(6px);
        }

        /* NAVBAR ORANGE THEME */
        .navbar-custom {
            background-color: #ff7a00;
        }

        .navbar-custom .nav-link,
        .navbar-custom .navbar-brand {
            color: white !important;
            font-weight: bold;
        }

        .navbar-custom .nav-link:hover {
            color: #ffe8d1 !important;
        }
    </style>
</head>

<body class="@ViewData["BodyClass"] ?? "default-page"">

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container-fluid px-3">

            <a class="navbar-brand" href="/">Foodezon</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
            </button>

            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="/Menu">Menu</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Cart">Cart</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Checkout">Checkout</a>
                    </li>

                </ul>
            </div>

        </div>
    </nav>

    <!-- MAIN PAGE CONTENT WITH ZERO PADDING -->
    <main style="padding:0; margin:0;">
        @RenderBody()
    </main>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
