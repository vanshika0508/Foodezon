@model Foodezon.Api.Models.ViewModels.MenuViewModel

@{
    ViewData["Title"] = "Menu";
}

<!-- FULLSCREEN BACKGROUND WITH DARK OVERLAY -->
<div class="menu-bg">

    <div class="container py-5">

        <div class="text-center mb-5">
            <h1 class="fw-bold" style="color:#ff7a00; font-size:3rem;">
                Explore Our Menu
            </h1>
            <p class="text-light fs-5">
                Authentic Indian flavors crafted fresh for you.
            </p>
        </div>

        @foreach (var cat in Model.Categories)
        {
            var anchor = cat.Name.Trim().ToLower();

            <div class="mb-5" id="@anchor">

                <h2 class="category-title">@cat.Name</h2>
                <p class="category-desc">@cat.Description</p>

                <div class="row g-4">

                    @if (cat.Dishes == null || !cat.Dishes.Any())
                    {
                        <p class="text-muted">No dishes available yet.</p>
                    }
                    else
                    {
                        @foreach (var dish in cat.Dishes)
                        {
                            <div class="col-md-4">
                                <div class="dish-card shadow-lg">

                                    @if (!string.IsNullOrEmpty(dish.ImageUrl))
                                    {
                                        <img src="@dish.ImageUrl" class="dish-img" alt="@dish.Name" />
                                    }

                                    <div class="p-3 d-flex flex-column">

                                        <h5 class="dish-name">@dish.Name</h5>
                                        <p class="dish-desc">@dish.Description</p>

                                        <p class="dish-price">$@dish.Price</p>

                                        <!-- Quantity Selector -->
                                        <div class="d-flex align-items-center mb-3">
                                            <button type="button"
                                                    class="qty-btn"
                                                    data-target="qty_@dish.Id"
                                                    data-change="-1">−</button>

                                            <span id="qty_@dish.Id" class="qty-number">0</span>

                                            <button type="button"
                                                    class="qty-btn"
                                                    data-target="qty_@dish.Id"
                                                    data-change="1">+</button>
                                        </div>

                                        <!-- Add to Cart -->
                                        <form method="post" action="/Cart/Add">
                                            <input type="hidden" name="dishId" value="@dish.Id" />
                                            <input type="hidden"
                                                   id="qtyInput_@dish.Id"
                                                   name="quantity" value="1" />

                                            <button type="submit"
                                                    class="add-btn"
                                                    data-dish="@dish.Id">
                                                Add to Cart
                                            </button>
                                        </form>

                                    </div>

                                </div>
                            </div>
                        }
                    }

                </div>
            </div>
        }

        <div class="text-center mt-5">
            <a href="/Cart" class="cart-button">Go to Cart</a>
        </div>

    </div>

</div>

<!-- FIXED JS -->
<script>
    // Quantity Button Logic
    document.querySelectorAll(".qty-btn").forEach(btn => {
        btn.addEventListener("click", function () {

            const targetId = this.getAttribute("data-target");
            const change = parseInt(this.getAttribute("data-change"));

            const qtyDisplay = document.getElementById(targetId);
            const dishId = targetId.split("_")[1];
            const input = document.getElementById("qtyInput_" + dishId);

            let qty = parseInt(qtyDisplay.textContent);
            qty += change;

            if (qty < 0) qty = 0;

            qtyDisplay.textContent = qty;

            if (qty === 0)
                input.value = 1;
            else
                input.value = qty;
        });
    });

    
</script>
